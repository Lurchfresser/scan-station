# Vorlage fuer die Konfiguration der scan-station.
#
# Lokal:   cp .env.example .env   und Werte eintragen (.env ist nicht im Git).
# Dokploy: die Zeilen in den Environment-Tab der App kopieren.
#
# Zeilen mit # sind Kommentare. Leere Werte schalten die Funktion ab.

# ---------------------------------------------------------------- Personen
# id:Name:PIN[:target], mehrere durch Komma getrennt.
#   id     nur Buchstaben, Ziffern, - und _ (bestimmt den Ordner der Scans)
#   Name   wird in der Anmeldung angezeigt, Leerzeichen erlaubt
#   PIN    mindestens 4 Zeichen, kein : und kein ,
#   target download (Standard): Scans bleiben auf dem Server zum Herunterladen
#          paperless: Scans gehen an Paperless (Kopie bleibt bis zur Frist)
SCAN_USERS=anna:Anna:BITTE-AENDERN:paperless,ben:Ben:BITTE-AENDERN

# ---------------------------------------------------------------- Betrieb
# Hinter Traefik/Dokploy true. Nur false, wenn der Port direkt freigegeben
# ist, sonst laesst sich die Anmeldesperre umgehen.
SCAN_TRUST_PROXY=true

# Ordner auf dem Host fuer die fertigen Scans (je Person ein Unterordner).
# Fester Pfad, damit die Scans ein Redeploy ueberleben.
DATA_DIR=/opt/scan-station-data

# Nach so vielen Tagen werden Scans geloescht, 0 schaltet das ab.
SCAN_RETENTION_DAYS=7

# Sprachen der Texterkennung (installiert: deu, eng).
SCAN_OCR_LANG=deu+eng

# Adresse der Weboberflaeche, fuer Links in Matrix-Nachrichten.
SCAN_PUBLIC_URL=https://scan.example.org

# ---------------------------------------------------------------- Scanner
# IP des Brother MFC-5440CN. Im Router fest zuweisen (DHCP-Reservierung).
SCANNER_IP=192.168.178.98

# ---------------------------------------------------------------- Paperless-ngx
# Noetig, sobald eine Person target paperless hat.
# Token: in Paperless oben rechts Benutzermenue -> Mein Profil -> API-Token.
# Die Dokumente gehoeren in Paperless der Person, zu der der Token gehoert.
PAPERLESS_URL=https://paperless.example.org
PAPERLESS_TOKEN=

# ---------------------------------------------------------------- Matrix (optional)
# Bot meldet Ende, Fehler und "Stapel umdrehen" im Direktchat.
# Alle drei setzen, sonst bleibt Matrix aus.
MATRIX_HOMESERVER=
MATRIX_TOKEN=
# id=@name:server, mehrere durch Komma. Personen ohne Eintrag bekommen nichts.
SCAN_MATRIX_USERS=
